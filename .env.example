# Zenith Environment Variables

# WebSocket Server
NEXT_PUBLIC_WS_URL=ws://localhost:3001
PORT=3001

# Dragonfly (Redis-compatible)
DRAGONFLY_PASSWORD=dragonfly_dev

# QuestDB
QUESTDB_PASSWORD=questdb_dev

# Binance
BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://zenith.xyz

# Node
NODE_ENV=development
