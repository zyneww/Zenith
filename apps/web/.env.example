# ─── Clerk (Authentication) ───
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_xxxxx
CLERK_SECRET_KEY=sk_xxxxx

# ─── Turso (Edge SQLite) ───
TURSO_URL=file:./zenith.db
TURSO_AUTH_TOKEN=

# ─── QuestDB (Time-series) ───
QUESTDB_URL=postgresql://zenith:questdb_dev@localhost:8812/qdb

# ─── Dragonfly (Redis) ───
REDIS_URL=redis://:dragonfly_dev@localhost:6379

# ─── Resend (Email) ───
RESEND_API_KEY=re_xxxxx

# ─── Cloudflare R2 (Storage) ───
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=zenith-assets

# ─── Sentry (Error Tracking) ───
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ─── Doppler (Secrets) ───
DOPPLER_TOKEN=

# ─── Next.js Public ───
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/fr/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/fr/sign-up
