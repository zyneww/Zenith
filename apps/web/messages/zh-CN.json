  "legal": {
    "terms": {
      "title": "服务条款",
      "lastUpdated": "2026年6月1日",
      "intro": "本条款规范您对 Zenith 的使用。使用我们的服务即表示您完全接受这些条款。",
      "sections": [
        {
          "title": "目的与接受",
          "content": "Zenith 是一个多资产金融情报平台。本服务条款规定了 Zenith 与服务用户之间的权利和义务。访问本平台即视为完全接受这些条款。"
        },
        {
          "title": "服务说明",
          "content": "Zenith 提供实时市场数据（加密货币、外汇、大宗商品、指数）、分析工具、经济日历、价格提醒和自选列表系统。服务按原样提供，不保证持续可用性或数据的绝对准确性。"
        },
        {
          "title": "用户义务",
          "content": "您同意仅为合法目的使用 Zenith，不试图干扰服务，不通过自动化手段大规模提取数据，并尊重 Zenith 及其合作伙伴的知识产权。"
        },
        {
          "title": "知识产权",
          "content": "Zenith 的所有内容（文字、图形、代码、设计）均受现行知识产权法律保护。未经授权的复制行为是被禁止的。"
        },
        {
          "title": "责任限制",
          "content": "Zenith 不对基于平台所提供信息做出的投资决策所造成的财务损失承担责任。市场数据仅供参考，不构成投资建议。"
        }
      ]
    },
    "privacy": {
      "title": "隐私政策",
      "lastUpdated": "2026年6月1日",
      "intro": "Zenith 致力于保护您的隐私。本政策说明我们收集哪些数据、如何使用以及您拥有哪些权利。",
      "sections": [
        {
          "title": "收集的数据",
          "content": "我们收集：(1) 通过 Clerk 注册时提供的账户数据（电子邮箱、姓名）；(2) 浏览数据（Cookie、IP）；(3) 您的偏好（自选列表、提醒、语言、货币）；(4) 用于改进服务的匿名化使用数据。"
        },
        {
          "title": "法律依据与目的",
          "content": "我们处理您的数据基于服务合同的履行（账户数据、偏好）以及我们改进服务的合法利益（匿名化分析）。我们绝不会将您的数据出售给第三方。"
        },
        {
          "title": "保留期限",
          "content": "您的账户数据在账户有效期内保留，账户删除后 30 天内删除。分析数据最多保留 13 个月。"
        },
        {
          "title": "您的权利（GDPR）",
          "content": "您拥有访问、更正、删除、携带以及反对处理您数据的权利。如需行使这些权利，请联系 privacy@zenith.xyz。"
        },
        {
          "title": "DPO 联系方式",
          "content": "我们的数据保护官可通过 dpo@zenith.xyz 联系。您也有权向主管监管机构提出投诉。"
        }
      ]
    },
    "cookies": {
      "title": "Cookie 政策",
      "lastUpdated": "2026年6月1日",
      "intro": "本页说明 Zenith 如何使用 Cookie 和类似技术。",
      "sections": [
        {
          "title": "什么是 Cookie",
          "content": "Cookie 是您访问网站时存储在设备上的小型文本文件。它允许网站在一定时间内记住您的操作和偏好。"
        },
        {
          "title": "必要 Cookie",
          "content": "这些 Cookie 是服务运行所必需的：Clerk 身份验证会话、语言偏好、提醒购物车。它们无法被禁用。"
        },
        {
          "title": "分析 Cookie",
          "content": "Zenith 使用匿名化的分析工具（可选 PostHog）来了解用户如何与平台互动。这些数据经过聚合处理，无法识别您的身份。"
        },
        {
          "title": "营销 Cookie",
          "content": "Zenith 不使用营销或广告 Cookie。不会为再营销或定向广告放置任何第三方 Cookie。"
        },
        {
          "title": "管理您的偏好",
          "content": "您可以通过浏览器设置管理 Cookie 偏好。禁用某些 Cookie 可能会限制平台的某些功能。"
        }
      ]
    },
    "accessibility": {
      "title": "无障碍",
      "lastUpdated": "2026年6月1日",
      "intro": "Zenith 致力于根据国际标准使平台对所有人开放。",
      "sections": [
        {
          "title": "我们的承诺",
          "content": "Zenith 致力于为所有人（包括残障人士）提供可用的服务。我们遵循 WCAG 2.1 AA 级建议。"
        },
        {
          "title": "WCAG 2.1 AA 标准",
          "content": "我们的界面遵循无障碍原则：足够的颜色对比、键盘导航、图片替代文本、语义化 HTML 结构、交互元素的 ARIA 标签。"
        },
        {
          "title": "无障碍功能",
          "content": "完整的键盘导航（Tab、Enter、Esc）、⌘K 快捷键（命令面板）、原生深色模式、屏幕阅读器支持（NVDA、JAWS、VoiceOver）、文字可放大至 200% 而不影响可读性。"
